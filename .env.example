# Nexus 環境變數範例 — 複製為 .env 後填入真實值
# 任何新增環境變數請同步更新本檔（見 .claude/CLAUDE.security.md）

# Node 環境（development / production / test）
NODE_ENV=development

# PostgreSQL 連線（本機開發走 loopback 5434，見 docker-compose db ports；容器內由 compose 覆寫為 db）
DATABASE_URL=postgresql://nexus:change_me@localhost:5434/nexus?schema=public

# docker-compose db 服務用
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change_me
POSTGRES_DB=nexus

# Auth.js v5
# 產生方式：openssl rand -base64 32
AUTH_SECRET=change_me
AUTH_URL=http://localhost:3000  # 部署時改為公開網域（HTTPS，session cookie 才會帶 Secure）
AUTH_TRUST_HOST=true

# docker compose 專案名（目錄名 Nexus_ 產生的預設名 nexus_ 會造成非法 image tag）
COMPOSE_PROJECT_NAME=nexus

# 應用程式對外 URL（Mail 確認連結等）
APP_URL=http://localhost:3000

# localdata 目錄（保密資料檔案儲存，TASK-004；容器內 compose 覆寫為 /app/localdata）
LOCALDATA_DIR=./localdata

# seed admin 帳號（TASK-002，可選；未設密碼則隨機產生並顯示一次）
# ADMIN_EMAIL=admin@nexus.local
# ADMIN_PASSWORD=請用強密碼

# 隱藏資料庫總覽頁 /admin/db 的 URL token（TASK-011；未設定時該頁一律 404）
# 產生方式：openssl rand -hex 32（64 字元、僅 hex 字元）
# 注意：不可用 openssl rand -base64——token 含 +/ 字元會被 URL 解碼改寫（+ 變空白）
# 使用方式：/admin/db?token=<此值>；勿分享網址，洩漏後請更換
# ADMIN_DB_TOKEN=
